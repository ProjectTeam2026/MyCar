<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCar.AddCarPage"
             BackgroundColor="#F9F7F0"
             Title="Добавить автомобиль">
    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,40" Spacing="20">
            <Label Text="Новый автомобиль"
                   FontSize="28"
                   TextColor="#4A4947"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />
            <VerticalStackLayout Spacing="5">
                <Label Text="Гос. номер" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryPlate"
                           Placeholder="А123БВ777"
                           TextColor="#4A4947"
                           PlaceholderColor="#D8D2C2"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Марка" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Picker x:Name="PickerBrand"
                            Title="Нажмите, чтобы выбрать"
                            TextColor="#4A4947"
                            TitleColor="#D8D2C2"
                            BackgroundColor="Transparent">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Toyota</x:String>
                                <x:String>BMW</x:String>
                                <x:String>Mercedes</x:String>
                                <x:String>Audi</x:String>
                                <x:String>Kia</x:String>
                                <x:String>Hyundai</x:String>
                                <x:String>Lada</x:String>
                                <x:String>Ford</x:String>
                                <x:String>Volkswagen</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Модель" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryModel"
                           Placeholder="Camry, X5, Solaris..."
                           TextColor="#4A4947"
                           PlaceholderColor="#D8D2C2"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Год выпуска" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryYear" Placeholder="2020"
                           Keyboard="Numeric"
                           MaxLength="4"
                           TextColor="#4A4947"
                           PlaceholderColor="#D8D2C2"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

      
            <VerticalStackLayout Spacing="5">
                <Label Text="VIN (необязательно)" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryVin"
                           Placeholder="17 символов"
                           MaxLength="17"
                           TextColor="#4A4947"
                           PlaceholderColor="#D8D2C2"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

          
            <VerticalStackLayout Spacing="5">
                <Label Text="ПТС (необязательно)" TextColor="#4A4947" FontAttributes="Bold" />
                <Border Stroke="#D8D2C2" StrokeThickness="1" BackgroundColor="#F9F7F0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryPts"
                           Placeholder="77 АА 123456"
                           TextColor="#4A4947"
                           PlaceholderColor="#D8D2C2"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Добавить авто"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="58"
                    CornerRadius="29"
                    BackgroundColor="#B17457"
                    TextColor="#F9F7F0"
                    Margin="0,20,0,0"
                    Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>