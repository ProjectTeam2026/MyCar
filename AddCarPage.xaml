<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCar.AddCarPage"
             BackgroundColor="#323232"
             Title="Добавить автомобиль">
    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,60" Spacing="20">

            <Button Text="‹" 
                    FontSize="40" 
                    FontFamily="Vetrino" 
                    TextColor="#F9F7F0" 
                    BackgroundColor="Transparent" 
                    HorizontalOptions="Start" 
                    Padding="0" 
                    Clicked="BackButton_Clicked" />
            
            <Label Text="Новый автомобиль"
                   FontFamily="Vetrino"
                   FontSize="32"
                   TextColor="#F9F7F0"
                   Margin="0,0,0,10" />

            
            <VerticalStackLayout Spacing="6">
                <Label Text="Гос. номер" TextColor="#D8D2C2" FontFamily="NexaTextLight" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryPlate"
                           Placeholder="А123БВ777"
                           FontFamily="NexaTextLight"
                           TextColor="#F9F7F0"
                           PlaceholderColor="#797775"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label Text="Марка" TextColor="#D8D2C2" FontFamily="NexaText" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Picker x:Name="PickerBrand"
                            Title="Выберите марку"
                            FontFamily="NexaTextLight"
                            TextColor="#F9F7F0"
                            TitleColor="#797775"
                            BackgroundColor="Transparent">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Toyota</x:String>
                                <x:String>BMW</x:String>
                                <x:String>Mercedes</x:String>
                                <x:String>Audi</x:String>
                                <x:String>Kia</x:String>
                                <x:String>Hyundai</x:String>
                                <x:String>Lada</x:String>
                                <x:String>Ford</x:String>
                                <x:String>Volkswagen</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label Text="Модель" TextColor="#D8D2C2" FontFamily="NexaTextLight" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryModel"
                           Placeholder="Camry, X5, Solaris..."
                           FontFamily="NexaTextLight"
                           TextColor="#F9F7F0"
                           PlaceholderColor="#797775"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label Text="Год выпуска" TextColor="#D8D2C2" FontFamily="NexaTextLight" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryYear" 
                           Placeholder="2020"
                           Keyboard="Numeric"
                           MaxLength="4"
                           FontFamily="NexaTextLight"
                           TextColor="#F9F7F0"
                           PlaceholderColor="#797775"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label Text="VIN (необязательно)" TextColor="#D8D2C2" FontFamily="NexaTextLight" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryVin"
                           Placeholder="17 символов"
                           MaxLength="17"
                           FontFamily="NexaTextLight"
                           TextColor="#F9F7F0"
                           PlaceholderColor="#797775"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            
            <VerticalStackLayout Spacing="6">
                <Label Text="ПТС (необязательно)" TextColor="#D8D2C2" FontFamily="NexaText" FontSize="14" />
                <Border Stroke="#4A4947" StrokeThickness="1" BackgroundColor="#3C3A39" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="EntryPts"
                           Placeholder="77 АА 123456"
                           FontFamily="NexaTextLight"
                           TextColor="#F9F7F0"
                           PlaceholderColor="#797775"
                           BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            
            <Button Text="Сохранить авто"
                    FontFamily="NexaTextLight"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="58"
                    CornerRadius="29"
                    BackgroundColor="#B17457"
                    TextColor="#F9F7F0"
                    Margin="0,20,0,0"
                    Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>