<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCar.GaragePage"
             Title="GaragePage">

    <Grid RowDefinitions="Auto,*,Auto">


        <VerticalStackLayout Grid.Row="0"
                         Padding="30,80,30,40"
                         Spacing="8">

            <Label Text="МОЙ ГАРАЖ"
               FontSize="12"
               CharacterSpacing="4"
               TextColor="#B17457"
               HorizontalOptions="Center" />

            <Label Text="Автомобиль"
               FontSize="42"
               TextColor="#4A4947"
               HorizontalOptions="Center" />

            <BoxView HeightRequest="1"
                 WidthRequest="60"
                 Color="#D8D2C2"
                 HorizontalOptions="Center"
                 Margin="0,12,0,0" />
        </VerticalStackLayout>


        <VerticalStackLayout Grid.Row="1"
                         VerticalOptions="Center"
                         Padding="30"
                         Spacing="10">
            <Label Text="Пока пусто"
               FontSize="16"
               TextColor="#D8D2C2"
               HorizontalOptions="Center" />
            <Label Text="Добавьте свой первый автомобиль"
               FontSize="14"
               TextColor="#D8D2C2"
               HorizontalOptions="Center" />
        </VerticalStackLayout>


        <VerticalStackLayout Grid.Row="2"
                         Padding="30,0,30,60"
                         Spacing="14">

            <Button Text="Список авто"
                FontSize="16"
                HeightRequest="58"
                CornerRadius="29"
                BackgroundColor="#4A4947"
                TextColor="#F9F7F0"
                BorderWidth="0"
                Clicked="OnCarListClicked" />

            <Button Text="Добавить авто"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="58"
                CornerRadius="29"
                BackgroundColor="#B17457"
                TextColor="#F9F7F0"
                BorderWidth="0"
                Clicked="OnAddCarClicked" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>