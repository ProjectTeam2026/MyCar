<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCar.ProfilePage"
             Title="ProfilePage">
    <Grid RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="30,50,30,30">
            <Label Text="Профиль" FontSize="30" FontFamily="Vetrino" TextColor="#4A4947" />
            <Label Text="Здесь будет информация о вас" FontSize="16" FontFamily="NexaTextLight" TextColor="#4A4947" Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" Margin="5,30,5,20" BackgroundColor="#B17457" StrokeThickness="0" StrokeShape="RoundRectangle 45" Padding="10">
            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Margin="10,0,10,0" Spacing="10">
                <Border StrokeThickness="0" Stroke="Transparent" HeightRequest="75" WidthRequest="65">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Home_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Image Source="home.png" Grid.Row="0" Margin="0,6,0,5"/>
                        <Label Grid.Row="1" Text="Главная" TextColor="#F9F7F0" FontSize="16" FontFamily="NexaTextLight" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border StrokeThickness="0" Stroke="Transparent" HeightRequest="75" WidthRequest="60">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Garage_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Image Source="car2.png" Grid.Row="0" Margin="0,2,0,3"/>
                        <Label Grid.Row="1" Text="Гараж" TextColor="#F9F7F0" FontSize="16" FontFamily="NexaTextLight" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border StrokeThickness="0" Stroke="Transparent" HeightRequest="75" WidthRequest="60">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Service_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Image Source="service2.png" Grid.Row="0" Margin="0,7,0,6"/>
                        <Label Grid.Row="1" Text="Сервис" TextColor="#F9F7F0" FontSize="16" FontFamily="NexaTextLight" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border StrokeThickness="0" Stroke="Transparent" HeightRequest="75" WidthRequest="60">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="News_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Image Source="news2.png" Grid.Row="0" Margin="0,7,0,6"/>
                        <Label Grid.Row="1" Text="Лента" TextColor="#F9F7F0" FontSize="16" FontFamily="NexaTextLight" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border StrokeThickness="0" Stroke="Transparent" HeightRequest="75" WidthRequest="75">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Profile_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Image Source="profile.png" Grid.Row="0" Margin="0,7,0,5"/>
                        <Label Grid.Row="1" Text="Профиль" TextColor="#F9F7F0" FontSize="16" FontFamily="NexaTextLight" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </Grid>
                </Border>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>