<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ym="clr-namespace:Yandex.MapKit.Maui;assembly=Yandex.MapKit.Maui"
    x:Class="MyCar.ServicePage"
    Title="Сервис"
    BackgroundColor="#F9F7F0">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label
                    Text="Сервис"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#4A4947" />

                <Label
                    Text="Заправки, автосервисы, мойки и эвакуаторы"
                    FontSize="14"
                    TextColor="#4A4947" />

                <Label
                    Text="Выбери город"
                    TextColor="#4A4947" />

                <Picker
                    x:Name="CityPicker"
                    Title="Выбрать город"
                    SelectedIndex="0"
                    BackgroundColor="White"
                    TextColor="#4A4947"
                    SelectedIndexChanged="OnCityChanged">

                    <Picker.Items>
                        <x:String>Москва</x:String>
                        <x:String>Санкт-Петербург</x:String>
                        <x:String>Казань</x:String>
                        <x:String>Сочи</x:String>
                        <x:String>Екатеринбург</x:String>
                    </Picker.Items>
                </Picker>

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="10">

                    <Button
                        x:Name="FuelTab"
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Заправки"
                        BackgroundColor="#B17457"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="OnFuelTabClicked" />

                    <Button
                        x:Name="ServiceTab"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="СТО"
                        BackgroundColor="#D8D2C2"
                        TextColor="#4A4947"
                        CornerRadius="12"
                        Clicked="OnServiceTabClicked" />

                    <Button
                        x:Name="WashTab"
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Мойки"
                        BackgroundColor="#D8D2C2"
                        TextColor="#4A4947"
                        CornerRadius="12"
                        Clicked="OnWashTabClicked" />

                    <Button
                        x:Name="TowTab"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Эвакуаторы"
                        BackgroundColor="#D8D2C2"
                        TextColor="#4A4947"
                        CornerRadius="12"
                        Clicked="OnTowTabClicked" />

                </Grid>

                <Label
                    x:Name="MapTitle"
                    Text="Карта Яндекса"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#4A4947" />

                <Border
                    x:Name="MapContainer"
                    Stroke="#D8D2C2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0"
                    HeightRequest="300">

                    <ym:YandexMapView
                        x:Name="YandexMap"
                        Center="55.751244, 37.618423"
                        Zoom="11"
                        IsClusteringEnabled="True" />

                </Border>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#B17457"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="StatusLabel"
                    Text="Загружаем данные..."
                    TextColor="#4A4947"
                    HorizontalTextAlignment="Center" />

                <CollectionView
                    x:Name="PlacesList"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label
                            Text="Объекты не найдены"
                            TextColor="#4A4947"
                            HorizontalTextAlignment="Center"
                            Margin="10" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="White"
                                Stroke="#D8D2C2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14"
                                Margin="0,4">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#4A4947" />

                                    <Label
                                        Text="{Binding DisplayType}"
                                        FontSize="13"
                                        TextColor="#B17457" />

                                    <Label
                                        Text="{Binding Address}"
                                        FontSize="14"
                                        TextColor="#4A4947"
                                        IsVisible="{Binding HasAddress}" />

                                    <Label
                                        Text="{Binding Coordinates}"
                                        FontSize="12"
                                        TextColor="#77736C"
                                        IsVisible="{Binding IsMapAvailable}" />

                                    <Label
                                        Text="{Binding Phone}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#B17457"
                                        IsVisible="{Binding IsPhoneService}" />

                                    <Button
                                        Text="Показать на карте"
                                        BackgroundColor="#D8D2C2"
                                        TextColor="#4A4947"
                                        CornerRadius="10"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnOpenMapClicked"
                                        IsVisible="{Binding IsMapAvailable}" />

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нижняя навигация -->
        <Border
            Grid.Row="1"
            Margin="5,30,5,20"
            BackgroundColor="#B17457"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 45"
            Padding="10">

            <HorizontalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Margin="10,0,10,0"
                Spacing="10">

                <Border
                    StrokeThickness="0"
                    HeightRequest="75"
                    WidthRequest="65">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Home_Tapped"/>
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="4*,2*">
                        <Image
                            Source="home.png"
                            Grid.Row="0"
                            Margin="0,6,0,5"/>

                        <Label
                            Grid.Row="1"
                            Text="Главная"
                            TextColor="#F9F7F0"
                            FontSize="16"
                            FontFamily="NexaTextLight"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border
                    StrokeThickness="0"
                    HeightRequest="75"
                    WidthRequest="60">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Garage_Tapped"/>
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="4*,2*">
                        <Image
                            Source="car2.png"
                            Grid.Row="0"
                            Margin="0,2,0,3"/>

                        <Label
                            Grid.Row="1"
                            Text="Гараж"
                            TextColor="#F9F7F0"
                            FontSize="16"
                            FontFamily="NexaTextLight"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border
                    StrokeThickness="0"
                    HeightRequest="75"
                    WidthRequest="60">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Service_Tapped"/>
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="4*,2*">
                        <Image
                            Source="service2.png"
                            Grid.Row="0"
                            Margin="0,7,0,6"/>

                        <Label
                            Grid.Row="1"
                            Text="Сервис"
                            TextColor="#F9F7F0"
                            FontSize="16"
                            FontFamily="NexaTextLight"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border
                    StrokeThickness="0"
                    HeightRequest="75"
                    WidthRequest="60">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="News_Tapped"/>
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="4*,2*">
                        <Image
                            Source="news2.png"
                            Grid.Row="0"
                            Margin="0,7,0,6"/>

                        <Label
                            Grid.Row="1"
                            Text="Лента"
                            TextColor="#F9F7F0"
                            FontSize="16"
                            FontFamily="NexaTextLight"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <Border
                    StrokeThickness="0"
                    HeightRequest="75"
                    WidthRequest="75">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Profile_Tapped"/>
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="4*,2*">
                        <Image
                            Source="profile.png"
                            Grid.Row="0"
                            Margin="0,7,0,5"/>

                        <Label
                            Grid.Row="1"
                            Text="Профиль"
                            TextColor="#F9F7F0"
                            FontSize="16"
                            FontFamily="NexaTextLight"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

            </HorizontalStackLayout>
        </Border>

    </Grid>
</ContentPage>
