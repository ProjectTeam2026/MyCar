<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyCar.LoginPage"
    BackgroundColor="#171717"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50,30,30"
            Spacing="0">


            <Button Text="‹" FontSize="40" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Start" Padding="0" Clicked="BackButton_Clicked" />
            <Label Text="Добро пожаловать!" TextColor="White" FontSize="30" FontAttributes="Bold" Margin="0,30,0,8" />
            <Label Text="Войдите в аккаунт, чтобы продолжить" TextColor="#999999" FontSize="16" Margin="0,0,0,35" />
            <Label Text="Телефон или Email" TextColor="White" FontSize="14" Margin="0,0,0,8" />
            <Border  BackgroundColor="#242424" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15,0" HeightRequest="55">
                <Entry x:Name="LoginEntry" Placeholder="Введите телефон или email"  PlaceholderColor="#777777" TextColor="White" BackgroundColor="Transparent"  FontSize="15" />

            </Border>

            <Label Text="Пароль"  TextColor="White" FontSize="14" Margin="0,22,0,8" />
            <Border BackgroundColor="#242424" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15,0" HeightRequest="55">
                <Entry x:Name="PasswordEntry" Placeholder="Введите пароль" PlaceholderColor="#777777" TextColor="White" BackgroundColor="Transparent" FontSize="15" IsPassword="True" />
            </Border>
            <Button Text="Забыли пароль?"  TextColor="#FFFFFF"  FontSize="14"  BackgroundColor="Transparent" HorizontalOptions="End"  Padding="0" Margin="0,10,0,25" />
            <Button Text="ВОЙТИ"  HeightRequest="58" CornerRadius="29" BackgroundColor="White" TextColor="#171717" FontSize="16" FontAttributes="Bold" Clicked="LoginButton_Clicked" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,25,0,0">
                <Label  Text="Нет аккаунта?"  TextColor="#888888"  FontSize="14"  VerticalOptions="Center" />
                <Button Text="Зарегистрироваться" TextColor="White" FontSize="14" FontAttributes="Bold" BackgroundColor="Transparent" Padding="0" Clicked="RegisterButton_Clicked" />

            </HorizontalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="#FF6B6B" FontSize="13" HorizontalTextAlignment="Center" IsVisible="False" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>