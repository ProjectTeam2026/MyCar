<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyCar.LoginPage"
    BackgroundColor="#4A4947"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50,30,30"
            Spacing="0">


            <Button Text="‹" FontSize="40" FontFamily="Vetrino" TextColor="#F9F7F0" BackgroundColor="Transparent" HorizontalOptions="Start" Padding="0" Clicked="BackButton_Clicked" />
            <Label Text="Добро пожаловать!" TextColor="#F9F7F0" FontSize="30" FontFamily="Vetrino" Margin="0,30,0,8" />
            <Label Text="Войдите в аккаунт, чтобы продолжить" TextColor="#F9F7F0" FontSize="15" FontFamily="NexaTextLight" Margin="0,0,0,35" />
            <Label Text="Телефон или Email" TextColor="#D8D2C2" FontSize="14" FontFamily="NexaTextLight" Margin="0,0,0,8" />
            <Border  BackgroundColor="#D8D2C2" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15,0" HeightRequest="55">
                <Entry x:Name="LoginEntry" Placeholder="Введите телефон или email"  PlaceholderColor="#4A4947" TextColor="#4A4947" BackgroundColor="Transparent"  FontSize="14" FontFamily="NexaTextLight" />
            </Border>

            <Label Text="Пароль"  TextColor="#D8D2C2" FontSize="14" Margin="0,22,0,8" />
            <Border BackgroundColor="#D8D2C2" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15,0" HeightRequest="55">
                <Entry x:Name="PasswordEntry" Placeholder="Введите пароль" PlaceholderColor="#4A4947" TextColor="#4A4947" BackgroundColor="Transparent" FontSize="14" FontFamily="NexaTextLight" IsPassword="True" />
            </Border>
            <Button Text="Забыли пароль?"  TextColor="#F9F7F0"  FontSize="14" FontFamily="NexaTextLight" BackgroundColor="Transparent" HorizontalOptions="End"  Padding="0" Margin="0,10,0,25" />
            <Button Text="ВОЙТИ" HeightRequest="56" CornerRadius="29" BackgroundColor="#B17457" TextColor="#D8D2C2" FontSize="18" FontFamily="Vetrino" FontAttributes="Bold" Clicked="LoginButton_Clicked" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,25,0,0">
                <Label  Text="Нет аккаунта?"  TextColor="#D8D2C2"  FontSize="14" FontFamily="NexaTextLight" VerticalOptions="Center" />
                <Button Text="Зарегистрироваться" TextColor="#F9F7F0" FontSize="14" FontFamily="NexaTextLight" FontAttributes="Bold" BackgroundColor="Transparent" Padding="0" Clicked="RegisterButton_Clicked" />
            </HorizontalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="#FF6B6B" FontSize="13" HorizontalTextAlignment="Center" IsVisible="False" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>